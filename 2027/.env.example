# Copy this file to `.env.local` and edit the values below to configure the
# site without touching source code. Both are resolved once at server start
# by `lib/site-config.ts`.

# Theme key from `lib/theme/themes.ts` (e.g. "2026", "2027", "greyscale").
SITE_THEME=2027

# Website lifecycle state — one of:
#   D   | Dormant
#   T   | Teaser
#   A   | Announcement & Ticket Posting
#   TO  | Ticket Registration Opens
#   RC  | Account Creation & Registration Close
#   FIR | Final Information Release
WEBSITE_STATE=A
